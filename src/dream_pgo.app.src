{application, dream_pgo,
 [{description, "Postgres client with connection pool, a fork of pgo"},
  {vsn, "git"},
  {registered, []},
  {mod, {dream_pgo_app, []}},
  {applications,
   [kernel,
    stdlib,
    backoff,
    opentelemetry_api,
    pg_types
   ]},
  {env,[]},
  {modules, []},

  {licenses, ["Apache-2.0"]},
  {links, [{"Github", "https://github.com/TrustBound/dream_pgo"},
           {"Upstream pgo", "https://github.com/erleans/pgo"}]}
 ]}.
